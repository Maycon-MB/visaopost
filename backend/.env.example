# Copy to .env and fill values. NEVER commit .env.

# App
APP_ENV=dev
LOG_LEVEL=INFO
JWT_SECRET=change-me-to-random-64-chars
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=24
SESSION_EXPIRES_HOURS=168
RESET_EXPIRES_MINUTES=60

# URLs (prod: trocar pelos domínios reais)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FRONTEND_URL=https://app.visaopost.com.br
# CORS_ORIGINS=https://app.visaopost.com.br

# Postgres (matches docker-compose.yml dev defaults)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=visaopost
POSTGRES_USER=visaopost
POSTGRES_PASSWORD=visaopost_dev
DATABASE_URL=postgresql://visaopost:visaopost_dev@postgres:5432/visaopost

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Gemini (Fase 0a — Google AI Studio free tier)
GEMINI_API_KEY=

# Resend (Fase 0a — free 3k email/mês)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@visaopost.com.br

# Instagram Graph API (Fase 9 — entregue pelo cliente)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# WhatsApp Cloud API (Fase 9 — entregue pelo cliente)
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
