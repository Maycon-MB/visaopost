---
const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';
const base = import.meta.env.BASE_URL?.replace(/\/$/, '') ?? '';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nosso Feed — Ótica Di Lorenzo</title>
  <meta name="description" content="Posts aprovados pela equipe Di Lorenzo. Conteúdo exclusivo sobre moda óptica e bem-estar visual." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />

  <style>
    /* ─── Reset ─────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; }

    /* ─── Tokens ─────────────────────────────────────────────── */
    :root {
      --ochre:       #C1750B;
      --ochre-dim:   rgba(193,117,11,0.14);
      --ochre-mid:   rgba(193,117,11,0.35);
      --black:       #03191E;
      --black-card:  #071d23;
      --white:       #F6F8FF;
      --muted:       rgba(246,248,255,0.45);
      --border:      rgba(193,117,11,0.12);
      --font:        'Jost', 'Corbel', 'Gill Sans', system-ui, sans-serif;
      --radius:      14px;
    }

    /* ─── Base ───────────────────────────────────────────────── */
    body {
      background: var(--black);
      color: var(--white);
      font-family: var(--font);
      min-height: 100dvh;
      overflow-x: hidden;
    }

    a { color: inherit; text-decoration: none; }

    /* ─── Nav ────────────────────────────────────────────────── */
    .nav {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      height: 64px;
      background: rgba(3,25,30,0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .nav-logo-circle {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 1.5px solid var(--ochre);
      overflow: hidden;
      background: var(--black);
      flex-shrink: 0;
    }

    .nav-logo-circle img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .nav-brand {
      font-size: 17px;
      font-weight: 300;
      letter-spacing: 0.05em;
      color: var(--white);
    }

    .nav-brand em {
      font-style: italic;
      color: var(--ochre);
      font-weight: 300;
    }

    .nav-back {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 400;
      color: var(--muted);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      transition: color 0.2s;
      /* reset button */
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      font-family: var(--font);
    }

    .nav-back:hover { color: var(--ochre); }
    .nav-back svg { transition: transform 0.2s; }
    .nav-back:hover svg { transform: translateX(-3px); }

    /* ─── Hero ───────────────────────────────────────────────── */
    .hero {
      padding: 4rem 1.5rem 2.5rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 70% 60% at 50% -10%, rgba(193,117,11,0.10) 0%, transparent 70%);
      pointer-events: none;
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ochre);
      margin-bottom: 1.25rem;
    }

    .hero-eyebrow::before,
    .hero-eyebrow::after {
      content: '';
      display: block;
      width: 24px;
      height: 1px;
      background: var(--ochre);
      opacity: 0.6;
    }

    .hero-title {
      font-size: clamp(3rem, 10vw, 7rem);
      font-weight: 200;
      line-height: 0.92;
      letter-spacing: -0.02em;
      color: var(--white);
    }

    .hero-title em {
      font-style: italic;
      font-weight: 300;
      color: var(--ochre);
    }

    .hero-sub {
      margin-top: 1.25rem;
      font-size: 14px;
      font-weight: 300;
      color: var(--muted);
      letter-spacing: 0.04em;
      max-width: 380px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-line {
      width: 48px;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--ochre), transparent);
      margin: 1.75rem auto 0;
    }

    /* ─── Grid ───────────────────────────────────────────────── */
    .gallery-wrap {
      max-width: 1080px;
      margin: 0 auto;
      padding: 2rem 1.25rem 5rem;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    @media (min-width: 600px) {
      .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (min-width: 960px) {
      .gallery-grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    }

    /* ─── Card ───────────────────────────────────────────────── */
    .post-card {
      background: var(--black-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      cursor: default;
      transition: transform 0.28s cubic-bezier(0.25,0.46,0.45,0.94),
                  border-color 0.28s ease,
                  box-shadow 0.28s ease;
      opacity: 0;
      transform: translateY(22px);
      animation: cardReveal 0.5s forwards;
      animation-delay: var(--delay, 0s);
    }

    @keyframes cardReveal {
      to { opacity: 1; transform: translateY(0); }
    }

    .post-card:hover {
      transform: translateY(-5px);
      border-color: var(--ochre-mid);
      box-shadow: 0 16px 40px rgba(0,0,0,0.5), 0 0 0 1px var(--ochre-mid);
    }

    .post-img-wrap {
      position: relative;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background: #0a1e24;
    }

    .post-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s cubic-bezier(0.25,0.46,0.45,0.94);
    }

    .post-card:hover .post-img-wrap img {
      transform: scale(1.04);
    }

    .post-status-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 4px;
      backdrop-filter: blur(8px);
    }

    .badge-posted {
      background: rgba(193,117,11,0.85);
      color: #fff;
    }

    .badge-approved {
      background: rgba(3,25,30,0.75);
      color: var(--ochre);
      border: 1px solid var(--ochre-mid);
    }

    .post-info {
      padding: 1rem 1.1rem 1.15rem;
    }

    .post-date {
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      color: var(--ochre);
      opacity: 0.8;
      margin-bottom: 0.55rem;
    }

    .post-caption {
      font-size: 14px;
      font-weight: 300;
      line-height: 1.55;
      color: rgba(246,248,255,0.82);
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .post-tags {
      margin-top: 0.8rem;
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }

    .post-tag {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.04em;
      color: var(--ochre);
      background: var(--ochre-dim);
      border: 1px solid transparent;
      border-radius: 4px;
      padding: 2px 7px;
      transition: border-color 0.2s, background 0.2s;
    }

    .post-card:hover .post-tag {
      border-color: rgba(193,117,11,0.25);
    }

    /* ─── Skeleton ───────────────────────────────────────────── */
    .skeleton-card {
      background: var(--black-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }

    .skel-img {
      aspect-ratio: 1/1;
      background: linear-gradient(90deg, #0d2229 25%, #122931 50%, #0d2229 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
    }

    .skel-info { padding: 1rem 1.1rem 1.15rem; }

    .skel-line {
      height: 10px;
      border-radius: 5px;
      background: linear-gradient(90deg, #0d2229 25%, #122931 50%, #0d2229 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
      margin-bottom: 0.6rem;
    }

    .skel-line.w-1\/3 { width: 33%; }
    .skel-line.w-full  { width: 100%; }
    .skel-line.w-5\/6  { width: 83%; }
    .skel-line.w-2\/3  { width: 66%; }

    @keyframes shimmer {
      to { background-position: -200% 0; }
    }

    /* ─── Empty ──────────────────────────────────────────────── */
    .empty-state {
      text-align: center;
      padding: 5rem 1.5rem;
      grid-column: 1 / -1;
    }

    .empty-icon {
      width: 56px;
      height: 56px;
      margin: 0 auto 1.5rem;
      opacity: 0.3;
      color: var(--ochre);
    }

    .empty-title {
      font-size: 1.25rem;
      font-weight: 300;
      font-style: italic;
      color: rgba(246,248,255,0.6);
      letter-spacing: 0.02em;
    }

    .empty-sub {
      font-size: 13px;
      font-weight: 300;
      color: var(--muted);
      margin-top: 0.5rem;
    }

    /* ─── Error ──────────────────────────────────────────────── */
    .error-banner {
      display: none;
      grid-column: 1 / -1;
      padding: 1rem 1.25rem;
      background: rgba(148,28,47,0.12);
      border: 1px solid rgba(148,28,47,0.25);
      border-radius: var(--radius);
      font-size: 13px;
      color: #e08090;
      text-align: center;
    }

    /* ─── Footer ─────────────────────────────────────────────── */
    .footer {
      text-align: center;
      padding: 2rem 1.5rem 3rem;
      font-size: 12px;
      color: var(--muted);
      letter-spacing: 0.06em;
      border-top: 1px solid var(--border);
    }

    .footer a {
      color: var(--ochre);
      opacity: 0.7;
      transition: opacity 0.2s;
    }

    .footer a:hover { opacity: 1; }
  </style>
</head>
<body>

  <!-- Nav -->
  <nav class="nav">
    <div class="nav-logo">
      <div class="nav-logo-circle">
        <img src={`${base}/dl-logo.png`} alt="Di Lorenzo" />
      </div>
      <span class="nav-brand">di <em>Lorenzo</em></span>
    </div>
    <button class="nav-back" onclick="window.history.length > 1 ? window.history.back() : window.close()" type="button">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      Voltar
    </button>
  </nav>

  <!-- Hero -->
  <header class="hero">
    <div class="hero-eyebrow">
      <span></span>Instagram<span></span>
    </div>
    <h1 class="hero-title">
      Nosso<br /><em>Feed</em>
    </h1>
    <p class="hero-sub">Posts aprovados pela nossa equipe. Moda óptica, saúde visual e estilo de vida.</p>
    <div class="hero-line"></div>
  </header>

  <!-- Gallery -->
  <main class="gallery-wrap">
    <div class="gallery-grid" id="gallery-grid">
      <!-- 6 skeletons iniciais -->
      {Array.from({length: 6}).map(() => (
        <div class="skeleton-card">
          <div class="skel-img"></div>
          <div class="skel-info">
            <div class="skel-line w-1/3" style="margin-bottom:0.8rem"></div>
            <div class="skel-line w-full"></div>
            <div class="skel-line w-5/6"></div>
            <div class="skel-line w-2/3"></div>
          </div>
        </div>
      ))}
    </div>
  </main>

  <footer class="footer">
    <p>© 2026 Ótica Di Lorenzo &nbsp;·&nbsp; <a href={`${base}/`}>Página inicial</a> &nbsp;·&nbsp; <a href="https://instagram.com/oticadilorenzo" target="_blank" rel="noopener">@oticadilorenzo</a></p>
  </footer>

  <script is:inline define:vars={{ API_URL }}>
    const grid = document.getElementById('gallery-grid');

    const MONTH_PT = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];

    function fmtDate(iso) {
      const d = new Date(iso);
      if (isNaN(d)) return '';
      return `${String(d.getUTCDate()).padStart(2,'0')} ${MONTH_PT[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
    }

    function statusLabel(s) {
      return s === 'posted' ? 'Publicado' : 'Aprovado';
    }

    function renderCard(post, index) {
      const delay = `${(index * 0.07).toFixed(2)}s`;
      const imgSrc = `${API_URL}${post.image_url}`;
      const tags = (post.hashtags ?? []).slice(0, 6);

      const article = document.createElement('article');
      article.className = 'post-card';
      article.style.setProperty('--delay', delay);

      article.innerHTML = `
        <div class="post-img-wrap">
          <img src="${imgSrc}" alt="Post Di Lorenzo — ${post.theme ?? ''}" loading="lazy" />
          <span class="post-status-badge ${post.status === 'posted' ? 'badge-posted' : 'badge-approved'}">
            ${statusLabel(post.status)}
          </span>
        </div>
        <div class="post-info">
          <time class="post-date">${fmtDate(post.scheduled_at)}</time>
          <p class="post-caption">${post.caption ?? ''}</p>
          ${tags.length ? `
          <div class="post-tags">
            ${tags.map(t => `<span class="post-tag">#${t}</span>`).join('')}
          </div>` : ''}
        </div>
      `;

      return article;
    }

    function renderEmpty() {
      grid.innerHTML = `
        <div class="empty-state">
          <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="5"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
          <p class="empty-title">Em breve, novidades aqui.</p>
          <p class="empty-sub">Os posts aprovados aparecerão nesta galeria.</p>
        </div>
      `;
    }

    function renderError() {
      grid.innerHTML = `
        <div class="error-banner" style="display:block">
          Não foi possível carregar o feed. Tente novamente em instantes.
        </div>
      `;
    }

    async function loadGallery() {
      try {
        const res = await fetch(`${API_URL}/public/dilorenzo/gallery?limit=30`, {
          headers: { 'Accept': 'application/json' }
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const posts = await res.json();

        if (!posts.length) {
          renderEmpty();
          return;
        }

        grid.innerHTML = '';
        posts.forEach((post, i) => grid.appendChild(renderCard(post, i)));
      } catch (err) {
        console.error('[gallery] fetch failed:', err);
        renderError();
      }
    }

    loadGallery();
  </script>
</body>
</html>
