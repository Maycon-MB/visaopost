---
import LandingPage from '../components/LandingPage.jsx';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Ótica Di Lorenzo — A melhor curadoria de armações do mundo aliada à tecnologia de ponta para sua saúde ocular." />
  <title>Ótica Di Lorenzo — Óptica Premium</title>
  <meta property="og:title" content="Ótica Di Lorenzo" />
  <meta property="og:description" content="A melhor curadoria de armações do mundo aliada à tecnologia de ponta para sua saúde ocular." />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "Optician"],
    "name": "Ótica Di Lorenzo",
    "description": "A melhor curadoria de armações do mundo aliada à tecnologia de ponta para sua saúde ocular.",
    "address": { "@type": "PostalAddress", "addressLocality": "Rio de Janeiro", "addressRegion": "RJ", "addressCountry": "BR" },
    "sameAs": ["https://instagram.com/otica.dilorenzo"]
  })}</script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { overflow-x: hidden; }
  </style>
</head>
<body>
  <LandingPage client:load baseUrl={import.meta.env.BASE_URL} />
</body>
</html>
